        }
      }
    },
    "The server rejected the client certificate." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Server hat das Client-Zertifikat abgelehnt."
          }
        }
      }
    },
    "The user lacks permission for this operation." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Benutzer fehlt die Berechtigung für diesen Vorgang."
          }
        }
      }
    },
    "This etcd cluster was started without the JSON gateway (--enable-grpc-gateway=false), so etcetera cannot connect to it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
