            "value" : "%1$@ erfordert etcd %2$@ oder neuer."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@ requires etcd %2$@ or later."
          }
        }
      }
    },
    "Authentication is required or the credentials were rejected." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine Authentifizierung ist erforderlich oder die Anmeldedaten wurden abgelehnt."
          }
        }
      }
    },
