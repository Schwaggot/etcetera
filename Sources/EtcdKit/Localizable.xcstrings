          "stringUnit" : {
            "state" : "translated",
            "value" : "Die PKCS#12-Datei konnte nicht gelesen werden: %@"
          }
        }
      }
    },
    "The requested revision has been compacted away (compact revision %lld)." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die angeforderte Revision wurde durch Kompaktierung entfernt (Kompaktierungsrevision %lld)."
          }
        }
      }
    },
    "The server certificate is not trusted: %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dem Serverzertifikat wird nicht vertraut: %@"
